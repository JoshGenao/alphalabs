# .claude/ is local session state (settings.local.json, plans/) EXCEPT the skills,
# which are project tooling: they must be tracked to reach every worktree and any
# scheduled/cloud run. Same reason CLAUDE.md and docs/playbooks/ are tracked.
.claude/*
!.claude/skills/
.vscode/

.DS_Store
.devserver.pid
.devserver.log
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
node_modules/
target/
data/

# Secrets — never commit
.env
.env.*
!.env.example
.envrc
*.key
*.pem
secrets.toml
# Credential vault + key material (SRS-SEC-001). ./secrets is the operator's
# vault directory per .env.example; *.key alone did not cover the sealed vault
# file or anything else dropped in here.
secrets/

# Build / coverage artifacts
htmlcov/
.coverage
.coverage.*
coverage.xml
pytest.xml
pytest-*.xml
dist/
build/
*.egg-info/

# Critic Agent local artifacts
.critic_report.json

# .harness/ is verification evidence and it MUST be tracked: close_feature.py
# reads .harness/runs/<id>/evidence.json on main to decide whether a feature may
# flip to passes:true, and .harness/closes.jsonl / overrides.jsonl are the audit
# trail for every flip and every --force-complete. An untracked record would make
# the gate unverifiable by anyone but the machine that produced it.
# Only genuinely local scratch under it is ignored:
.harness/tmp/

# Agent pool — ephemeral coordination state (feature_deps.json IS committed)
tools/.agent_runtime.json
tools/.agent_pool.lock
# Codex usage-limit cooldown cache (written by tools/adversarial_review.py)
tools/.codex_cooldown.json
