# .claude/ is local session state (settings.local.json, plans/) EXCEPT the skills,
# which are project tooling: they must be tracked to reach every worktree and any
# scheduled/cloud run. Same reason CLAUDE.md and docs/playbooks/ are tracked.
.claude/*
!.claude/skills/
.vscode/

.DS_Store
.devserver.pid
.devserver.log
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
node_modules/
target/
data/

# Secrets — never commit
.env
.env.*
!.env.example
.envrc
*.key
*.pem
secrets.toml
# Credential vault + key material (SRS-SEC-001). ./secrets is the operator's
# vault directory per .env.example; *.key alone did not cover the sealed vault
# file or anything else dropped in here.
secrets/

# Build / coverage artifacts
htmlcov/
.coverage
.coverage.*
coverage.xml
pytest.xml
pytest-*.xml
dist/
build/
*.egg-info/

# Critic Agent local artifacts
.critic_report.json

# .harness/runs/ is verification evidence and MUST be tracked: the agent commits its
# feature's record with its branch, close_feature.py reads it to decide whether the
# feature may flip to passes:true, and then RETIRES it (renames it to closed-<ts>.json)
# so a reopened feature cannot inherit it. The archived records are the durable audit
# of what was actually run, alongside the git history of feature_list.json.
#
# The .jsonl ledgers are NOT tracked. They are written to the primary checkout — the
# one place an agent's worktree cannot reach — precisely so no branch can append to
# them, which also means no branch can commit them. They are a local operational log
# of closes and overrides, not a distributed audit trail; do not describe them as one.
.harness/tmp/
.harness/*.jsonl

# Agent pool — ephemeral coordination state (feature_deps.json IS committed)
tools/.agent_runtime.json
tools/.agent_pool.lock
# Codex usage-limit cooldown cache (written by tools/adversarial_review.py)
tools/.codex_cooldown.json
