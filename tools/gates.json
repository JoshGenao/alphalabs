  "excluded": [
    {
      "name": "critic_check",
      "why": "The deterministic critic, not a contract gate. It runs against a DIFF (--staged / --range), not the tree, and has its own pre-commit hook and its own ci.yml step. Running it from a tree-scoped runner would be meaningless."
    },
    {
      "name": "gates_registry_check",
      "why": "The registry's own validator. ci.yml runs it as an explicit step BEFORE verify_contracts.sh, so a broken registry is caught by something that does not itself read the broken registry."
    }
  ]
